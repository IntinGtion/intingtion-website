ErrorDocument 404 /404.html

# Browser-Caching für statische Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Beispiel: alte, "schöne" URLs auf deine echten HTML-Dateien leiten
RewriteRule ^kontakt/?$ /kontakt.html [R=301,L]
RewriteRule ^videos/?$ /resources/videos.html [R=301,L]
RewriteRule ^spielfelder/?$ /resources/fields.html [R=301,L]
RewriteRule ^loadout/?$ /resources/loadout.html [R=301,L]
RewriteRule ^about/?$ /resources/about.html [R=301,L]
RewriteRule ^blog/?$ /resources/blog/index.html [R=301,L]
